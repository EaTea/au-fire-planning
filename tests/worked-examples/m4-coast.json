      "arithmetic": [
        "FI number at 2042 = $1,600,000 x 1.025^16 = $2,375,208.99",
        "Cash $20,000 x 1.04^16 = $37,459.62; portfolio needed = ($2,375,208.99 - $37,459.62) / 1.07^16 (2.9522) = $791,876.59",
        "Coast FIRE number = $20,000 + $791,876.59 = $811,876.59; in 2042 dollars x 1.025^16 = $1,205,235.36",
        "Reached in 2029 (age 37): investable $1,000,975.24 vs $992,580.16"
      ],
      "expected": {
        "coast": {
          "number": 811876.59,
          "numberInRetirementYearDollars": 1205235.36,
          "reached": {
            "yearIndex": 3,
            "calendarYear": 2029,
            "age": 37,
            "investable": 1000975.24,
            "coastNumber": 992580.16
          }
        }
      }
