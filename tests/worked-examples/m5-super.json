        "contributionsStopAge": null,
        "retirementSpending": null,
        "safeWithdrawalRate": 0.04,
        "salaryAnnual": 90000,
        "salaryGrowth": { "kind": "none" }
      },
      "arithmetic": [
        "No growth: $90,000 in every working row (ages 41 and 42)",
        "Age 43 is after the retirement age of 42: $0"
      ],
      "expected": {
        "salaryRows": [
          { "yearIndex": 1, "salary": 90000 },
          { "yearIndex": 2, "salary": 90000 },
